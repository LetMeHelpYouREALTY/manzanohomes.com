{
  "framework": "nextjs",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    {
      "source": "/homes-near/manzano-elementary",
      "destination": "/homes-near-manzano-elementary",
      "permanent": true
    },
    {
      "source": "/homes-near/green-valley-high-school",
      "destination": "/homes-near-green-valley-high-school",
      "permanent": true
    },
    {
      "source": "/homes-near/coronado-high-school",
      "destination": "/homes-near-coronado-high-school",
      "permanent": true
    },
    {
      "source": "/homes-near/southeast-career-technical-academy",
      "destination": "/homes-near-southeast-career-technical-academy",
      "permanent": true
    }
  ]
}
